# Copy to .env and fill in real values before `docker compose up`.
# Never commit the real .env - see ../.gitignore.

MARKETPULSE_SECRET_KEY=generate-a-long-random-string-here
MARKETPULSE_ADMIN_USERNAME=admin
MARKETPULSE_ADMIN_PASSWORD=change-me

MARKETPULSE_POSTGRES_DB=marketpulse
MARKETPULSE_POSTGRES_USER=marketpulse
MARKETPULSE_POSTGRES_PASSWORD=change-me-too

# How often (minutes) the background loop re-fetches feeds and recomputes
# the outlook.
MARKETPULSE_INGEST_INTERVAL_MINUTES=30

# Yahoo Finance symbol syntax, e.g. ^IXIC (NASDAQ Composite), ^GSPC (S&P 500),
# ^DJI (Dow), or any ticker (AAPL, TSLA, ...).
MARKETPULSE_PRIMARY_SYMBOL=^IXIC
MARKETPULSE_PRIMARY_SYMBOL_LABEL=NASDAQ Composite

# Host port the dashboard/API is published on (container always listens on
# 8000 internally). Keep this different from BinMarket's 8000/5173 if both
# run on the same machine.
MARKETPULSE_HOST_PORT=8300
