# ==============================================================================
# BinMarket — configuración de entorno
# Copiar a ".env" y completar. Nunca commitear el archivo ".env" real.
# ==============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=UTC

# --- Usuario único de la aplicación (se crea/actualiza al iniciar el backend) -
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Binance -------------------------------------------------------------------
# IMPORTANTE: las API Keys usadas aquí NUNCA deben tener habilitado el permiso
# de "Enable Withdrawals". Usar solo permisos de lectura + trading spot.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# testnet|production — controla contra qué entorno de Binance se conecta el
# ExecutionProvider de Testnet/Live. El modo operativo real (PAPER/TESTNET/LIVE)
# se controla desde la aplicación (Settings), no solo con esta variable.
BINANCE_ENVIRONMENT=testnet

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=binmarket
POSTGRES_USER=binmarket
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS / frontend ---------------------------------------------------------
# Orígenes permitidos separados por coma. En despliegue detrás de nginx (mismo
# origen) puede dejarse vacío.
CORS_ORIGINS=http://localhost:5173

# --- Notificaciones (opcional, todas desactivadas si se dejan vacías) --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=

# --- Trading engine ------------------------------------------------------------
# Intervalo en segundos del loop principal de análisis
ENGINE_LOOP_INTERVAL_SECONDS=15
